# Mission Control Environment Variables
# Copy this to .env.local and fill in your values

# Authentication (for login page - server-side only, never NEXT_PUBLIC_)
MISSION_CONTROL_USERNAME=your-email@example.com
MISSION_CONTROL_PASSWORD=your-secure-password

# Hermes Bridge API (server-side only)
MISSION_CONTROL_API_KEY=your-api-key
HERMES_BRIDGE_URL=https://your-bridge-url.ngrok-free.dev
