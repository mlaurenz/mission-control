# Mission Control Environment Variables
# Copy this to .env.local and fill in your values

# Authentication
MISSION_CONTROL_USERNAME=your_username
MISSION_CONTROL_PASSWORD=your_password
MISSION_CONTROL_API_KEY=your_api_key

# Hermes Bridge URL (your VPS IP or domain)
HERMES_BRIDGE_URL=http://YOUR_VPS_IP:3001
